{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.json",
      "**/*.jsonc",
      "**/*.ts",
      "*.code-workspace",
      "!packages",
      "!examples"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  }
}
